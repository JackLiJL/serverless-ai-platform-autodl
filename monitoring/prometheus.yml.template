global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'inference-service'
    static_configs:
      - targets: ['host.docker.internal:8000']
        labels:
          instance: 'autodl-gpu'

remote_write:
  - url: ${GF_PROMETHEUS_URL}
    basic_auth:
      username: ${GF_USER}
      password: ${GF_API_KEY}
